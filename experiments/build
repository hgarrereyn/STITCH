#!/usr/bin/env python3
import argparse
from pathlib import Path
import subprocess
from typing import List

def run(args):
    if args.experiment.startswith('base'):
        build_base(args.experiment)
    else:
        print(f'Building base')
        build_base('base')

        print(f'Building experiment: {args.experiment}')
        build_experiment(args.experiment)

def build_base(base):
    # Build base image in root folder context.
    result = subprocess.run(['docker', 'build', '..', '-f', f'{base}/Dockerfile', '-t', f'gfafl_{base}'])
    if result.returncode != 0:
        raise RuntimeError(f'Failed to build base image {base}')

def build_experiment(experiment):
    # Build experiment in subfolder root.
    result = subprocess.run(['docker', 'build', f'./{experiment}', '-f', f'{experiment}/Dockerfile', '-t', f'gfafl_{experiment}'])
    if result.returncode != 0:
        raise RuntimeError(f'Failed to build experiment image {experiment}')

def get_choices() -> List[str]:
    return [x.stem for x in Path('.').iterdir() if x.is_dir()]

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('experiment', choices=get_choices())
    args = parser.parse_args()
    run(args)

if __name__ == '__main__':
    main()