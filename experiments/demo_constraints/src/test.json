{
    "objects": [
        {
            "name": "obj_t *",
            "attrs": [
                {
                    "name": "refcount",
                    "type": "int"
                }
            ]
        }
    ],
    "endpoints": [
        {
            "name": "obj_init_api",
            "template": "obj_init_api();"
        },
        {
            "name": "obj_create",
            "variables": [
                {
                    "name": "__data",
                    "dir": "*",
                    "typ": "int"
                },
                {
                    "name": "__obj_copy",
                    "dir": "new",
                    "typ": "obj_t *"
                }
            ],
            "template": "__obj_copy = obj_create(__data);",
            "effects": [
                "__obj_copy.refcount := 1"
            ]
        },
        {
            "name": "obj_ref",
            "variables": [
                {
                    "name": "__obj",
                    "dir": "*",
                    "typ": "obj_t *"
                }
            ],
            "template": "obj_ref(__obj);",
            "effects": [
                "__obj.refcount := __obj.refcount + 1"
            ]
        },
        {
            "name": "obj_unref",
            "variables": [
                {
                    "name": "__obj",
                    "dir": "*",
                    "typ": "obj_t *"
                }
            ],
            "template": "obj_unref(__obj);",
            "preconditions": [
                "__obj.refcount >= 0"
            ],
            "effects": [
                "__obj.refcount := __obj.refcount - 1"
            ]
        },
        {
            "name": "obj_delete",
            "variables": [
                {
                    "name": "__obj",
                    "dir": "del",
                    "typ": "obj_t *"
                }
            ],
            "template": "obj_delete(__obj);",
            "preconditions": [
                "__obj.refcount == 1"
            ]
        },
        {
            "name": "obj_clone",
            "variables": [
                {
                    "name": "__obj_copy",
                    "dir": "new",
                    "typ": "obj_t *"
                },
                {
                    "name": "__obj",
                    "dir": "*",
                    "typ": "obj_t *"
                }
            ],
            "template": "obj_clone(&__obj_copy, __obj);"
        },
        {
            "name": "obj_get_data",
            "variables": [
                {
                    "name": "__obj",
                    "dir": "*",
                    "typ": "obj_t *"
                },
                {
                    "name": "__data",
                    "dir": "new",
                    "typ": "int"
                }
            ],
            "template": "__data = obj_get_data(__obj);"
        },
        {
            "name": "obj_set_data",
            "variables": [
                {
                    "name": "__obj",
                    "dir": "*",
                    "typ": "obj_t *"
                },
                {
                    "name": "__data",
                    "dir": "*",
                    "typ": "int"
                }
            ],
            "template": "obj_set_data(__obj, __data);"
        }
    ]
}
